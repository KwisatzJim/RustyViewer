{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustyViewer", "version": "0.2.0", "identifier": "com.jim.rustyviewer",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "RustyViewer", "width": 1280, "height": 840, "minWidth": 800, "minHeight": 600, "backgroundColor": "#111316" }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["assets/icon-32.png", "assets/icon-128.png", "assets/icon-256.png"], "category": "Photography", "shortDescription": "A focused image viewer and editor", "fileAssociations": [{"ext": ["png", "jpg", "jpeg", "webp", "gif", "bmp", "tif", "tiff", "ico"], "name": "Image", "role": "Viewer"}], "macOS": { "minimumSystemVersion": "11.0" } }
}
