{
  "name": "rustyviewer-ui",
  "version": "0.2.1",
  "private": true,
  "description": "Optional development tools; the desktop app needs no Node runtime or frontend build step.",
  "scripts": {
    "check": "node --check ui/app.js",
    "format": "prettier --write ui/*.{html,css,js}",
    "format:check": "prettier --check ui/*.{html,css,js}",
    "version:check": "node scripts/check-version.mjs",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "prettier": "3.9.6"
  }
}
